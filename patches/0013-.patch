From 57eee096c8b9e4ccc3e08dc7ddb9c620b8367250 Mon Sep 17 00:00:00 2001
From: l1l1lkk <2016895486@qq.com>
Date: Tue, 12 May 2026 14:43:15 +0800
Subject: [PATCH 13/13] @ Fix: auto-correct head_dim when it conflicts with
 hidden_size

When HF text_config explicitly sets head_dim=128 but the model has
different hidden_size/num_heads ratio, auto-compute head_dim instead
of raising AssertionError. Applies to both Qwen2Config and Qwen3Config.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
@
---
 lite_llama/models/model_config.py | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/lite_llama/models/model_config.py b/lite_llama/models/model_config.py
index b6c1d8d..b3478f4 100644
--- a/lite_llama/models/model_config.py
+++ b/lite_llama/models/model_config.py
@@ -166,8 +166,9 @@ class Qwen2Config(BaseConfig):
             self.num_kv_heads = self.num_heads
         if self.intermediate_size is None:
             self.intermediate_size = self.hidden_size * 4
-        if self.head_dim is None:
-            self.head_dim = self.hidden_size // self.num_heads
+        computed_head_dim = self.hidden_size // self.num_heads
+        if self.head_dim is None or self.head_dim * self.num_heads != self.hidden_size:
+            self.head_dim = computed_head_dim
         assert self.hidden_size == self.head_dim * self.num_heads
 
 
@@ -212,8 +213,9 @@ class Qwen3Config(BaseConfig):
             self.num_kv_heads = self.num_heads
         if self.intermediate_size is None:
             self.intermediate_size = self.hidden_size * 4
-        if self.head_dim is None:
-            self.head_dim = self.hidden_size // self.num_heads
+        computed_head_dim = self.hidden_size // self.num_heads
+        if self.head_dim is None or self.head_dim * self.num_heads != self.hidden_size:
+            self.head_dim = computed_head_dim
         assert self.hidden_size == self.head_dim * self.num_heads
 
 
